# Secrets. A .env copied into a layer stays readable via `docker history`
# even if a later layer deletes it.
.env
.env.*
!.env.example

# Credentials that may sit in the tree during local work.
**/*.pem
**/*.key
.aws/

.git/
.gitignore
.github/

# Build output and live-reload scratch space.
tmp/
*.out
coverage.*

# Nothing here affects the binary.
CLAUDE.md
README.md
*.md
.air.toml
Dockerfile
.dockerignore
deploy/
docs/
